  "pages": {
    "index.html": {
      "settings": {
        "main": true,
        "title": "SodaPeak – Advanced Support for Nerve Health",
        "meta_descr": "SodaPeak is a dietary supplement taken every day in gummy form for male adults who require extra support for energy, endurance, physical performance, and vitality. SodaPeak's unique form allows users to conveniently incorporate it into their daily wellness regimen without mixing powder supplements or taking usual capsules. SodaPeak is meant for men who would like to have an active life, to feel more energized during the day, and help to maintain their well-being. This supplement is meant as an addition to the healthy way of living, which includes good nutrition, physical exercise, enough sleep, and hydration.\n\nIt is specifically formulated to avoid dependency and is designed to be enjoyed as a simple daily gummy — supporting energy, drive and long-term confidence.",
        "header_custom": "<meta name=\"keywords\" content=\"prosta defend, prostadefend, prosta defend supplement, prosta defend pills\">\n <meta name=\"author\" content=\"prosta defend\">\n\t\t\n <link rel=\"canonical\" href=\"\" >",
        "footer_custom": "",
        "html_before": "",
        "meta_image": "@PROJECT_PATH@/assets/images/sodapeak-hero.webp"
      },
